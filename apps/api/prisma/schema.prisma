// Prisma schema — datasource + generator + Locker (AD-8).
//
// Story 1.2 introduces the first table: `locker`. StoredPackage arrives with
// Story 1.4, together with the partial unique index on `occupied_by` that
// enforces one package per locker. The schema is versioned from day one so
// `pnpm turbo run db:migrate` applies a real, committed migration history
// against `postgres:18-alpine`.
//
// Postgres 18 is the only durable state; every future change ships as a
// `prisma migrate` file committed with the story that introduces it, and is
// applied via `prisma migrate deploy` (never `db push`) — see AD-8.

generator client {
  provider = "prisma-client"
  output   = "../src/adapters/db/generated/prisma"
}

// Prisma 7: the connection URL lives in `prisma.config.ts` (datasource.url),
// not in the schema. The URL still comes from the DATABASE_URL env var, which
// the API validates once at boot (see src/config/env.ts).

datasource db {
  provider = "postgresql"
}

// The declared locker sizes (FR1). Mirrors `LOCKER_SIZES` in @locker/domain,
// which stays the single source of truth the API validates against; the enum
// exists so Postgres itself refuses a size outside the vocabulary.
enum LockerSize {
  SMALL
  MEDIUM
  LARGE
}

model Locker {
  id String @id @default(cuid())

  size LockerSize

  // The id of the StoredPackage currently inside (set on store, cleared on
  // retrieval). CAS target of the store transaction (AD-4); the partial
  // unique index on this column (see the create_stored_package migration)
  // makes "one package per locker" a schema fact, not just code (AD-8).
  occupiedBy String? @map("occupied_by")

  @@map("locker")
}

// A stored package's lifecycle (Epic 2 flips it to RETRIEVED).
enum PackageStatus {
  STORED
  RETRIEVED
}

// The package record created by the Story 1.4 store transaction. The link to
// its locker is `locker.occupied_by` (one direction only, per the spine's ER
// seed); `retrievedAt` / the RETRIEVED status stay unused until Epic 2.
model StoredPackage {
  id String @id @default(cuid())

  // Unique among STORED packages — enforced by the partial unique index in
  // the create_stored_package migration (AD-6), not by a plain unique here.
  pickupCode String @map("pickup_code")

  // Optional free-text reference the delivery agent may attach (FR3).
  customerRef String? @map("customer_ref")

  // Exact storage time, captured now and consumed by Epic 2's pricing (AD-5).
  storedAt DateTime @default(now()) @map("stored_at")

  // Unused until Epic 2 retrieval.
  retrievedAt DateTime? @map("retrieved_at")
  status      PackageStatus @default(STORED)

  @@map("stored_package")
}
