# Copy to .env for local development. These defaults match docker-compose.yml.
# Only DATABASE_URL is required; the rest have the documented defaults.

# Postgres 18 from docker-compose (`docker compose up -d postgres`).
# If 5432 is taken on your machine, set POSTGRES_PORT in docker-compose and
# point DATABASE_URL at that host port.
DATABASE_URL=postgres://locker:locker@localhost:5432/locker

# The credentials the compose stack is built from (docker compose interpolates
# them out of this file and refuses to start without them — copy this file to
# .env first). These are local development defaults, not secrets. If you change
# the password to something with special characters ( : / @ ? # ), URL-encode
# it so DATABASE_URL above stays valid.
POSTGRES_USER=locker
POSTGRES_PASSWORD=locker
POSTGRES_DB=locker

# Host port for the compose Postgres (container always listens on 5432).
# Only used by docker-compose; set it in the shell, not here.
# POSTGRES_PORT=55432

# Port the API listens on (default 3000)
PORT=3000

# Base storage fee per 24h day, in plain units (default 10, see AD-5)
STORAGE_FEE_BASE=10

# Optional: comma-separated origins allowed to call the API cross-origin.
# Unset = the CORS plugin is not registered at all (local dev reaches the API
# through the Vite proxy, same-origin).
# CORS_ORIGIN=http://localhost:8080

# Optional: where the integration suites truncate. Falls back to DATABASE_URL,
# so the value above is enough for local development and CI.
# TEST_DATABASE_URL=postgres://locker:locker@localhost:55432/locker
