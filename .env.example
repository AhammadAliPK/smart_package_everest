# Copy to .env for local development. These defaults match docker-compose.yml.
# Only DATABASE_URL is required; the rest have the documented defaults.

# Postgres 18 from docker-compose (`docker compose up -d postgres`).
# If 5432 is taken on your machine, set POSTGRES_PORT in docker-compose and
# point DATABASE_URL at that host port.
DATABASE_URL=postgres://locker:locker@localhost:5432/locker

# Host port for the compose Postgres (container always listens on 5432).
# Only used by docker-compose; set it in the shell, not here.
# POSTGRES_PORT=55432

# Port the API listens on (default 3000)
PORT=3000

# Base storage fee per 24h day, in plain units (default 10, see AD-5)
STORAGE_FEE_BASE=10
